{
  "entities": {
    "Provider": {
      "title": "Provider",
      "description": "A hospital, clinic, or diagnostic centre offering medical services.",
      "type": "object",
      "properties": {
        "providerId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "providerType": { "type": "string", "enum": ["Hospital", "Multi-Speciality Hospital", "Clinic", "Diagnostic Centre", "Eye Hospital", "Dialysis Centre", "Rehabilitation Centre"] },
        "address": { "type": "string", "minLength": 4, "maxLength": 300 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "state": { "type": "string", "minLength": 2, "maxLength": 80 },
        "pincode": { "type": "string", "maxLength": 16 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "phone": { "type": "string", "maxLength": 40 },
        "website": { "type": "string", "maxLength": 240 },
        "source": { "type": "string", "minLength": 2, "maxLength": 160 },
        "lastVerified": { "type": "string", "minLength": 4, "maxLength": 40 },
        "dataOrigin": { "type": "string", "enum": ["verified", "demo"] }
      },
      "required": ["providerId", "name", "providerType", "address", "city", "state", "latitude", "longitude", "source", "lastVerified", "dataOrigin"]
    },
    "Service": {
      "title": "Service",
      "description": "A specific medical service within Consultation, Diagnostics, or Treatment and Procedures.",
      "type": "object",
      "properties": {
        "serviceId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": { "type": "string", "enum": ["Consultation", "Diagnostics", "Treatment and Procedures"] },
        "serviceName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "description": { "type": "string", "minLength": 4, "maxLength": 400 }
      },
      "required": ["serviceId", "category", "serviceName", "description"]
    },
    "ProviderService": {
      "title": "ProviderService",
      "description": "Mapping record establishing whether a provider offers a specific service and its verification status.",
      "type": "object",
      "properties": {
        "recordId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "providerId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serviceId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "verificationStatus": { "type": "string", "enum": ["verified", "demo", "unverified"] },
        "source": { "type": "string", "minLength": 2, "maxLength": 160 },
        "lastVerified": { "type": "string", "minLength": 4, "maxLength": 40 },
        "dataOrigin": { "type": "string", "enum": ["verified", "demo"] }
      },
      "required": ["recordId", "providerId", "serviceId", "verificationStatus", "source", "lastVerified", "dataOrigin"]
    },
    "MedicalCharge": {
      "title": "MedicalCharge",
      "description": "Published or illustrative medical service charge for a provider and service pair.",
      "type": "object",
      "properties": {
        "chargeId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "providerId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serviceId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "amount": { "type": "number" },
        "minAmount": { "type": "number" },
        "maxAmount": { "type": "number" },
        "chargeType": { "type": "string", "enum": ["consultation_fee", "diagnostic_price", "treatment_package", "per_session"] },
        "sourceName": { "type": "string", "minLength": 2, "maxLength": 160 },
        "sourceUrl": { "type": "string", "maxLength": 240 },
        "lastVerified": { "type": "string", "minLength": 4, "maxLength": 40 },
        "verificationStatus": { "type": "string", "enum": ["verified", "demo", "unverified"] },
        "dataOrigin": { "type": "string", "enum": ["verified", "demo"] }
      },
      "required": ["chargeId", "providerId", "serviceId", "chargeType", "sourceName", "lastVerified", "verificationStatus", "dataOrigin"]
    },
    "Accommodation": {
      "title": "Accommodation",
      "description": "Nearby hotel, guest house, or lodge record with optional nightly pricing.",
      "type": "object",
      "properties": {
        "accommodationId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "accommodationType": { "type": "string", "enum": ["Hotel", "Guest House", "Lodge", "Serviced Apartment", "Dharamshala / Patient Stay"] },
        "address": { "type": "string", "minLength": 4, "maxLength": 300 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "minNightlyPrice": { "type": "number" },
        "maxNightlyPrice": { "type": "number" },
        "priceSource": { "type": "string", "minLength": 2, "maxLength": 160 },
        "lastVerified": { "type": "string", "minLength": 4, "maxLength": 40 },
        "dataOrigin": { "type": "string", "enum": ["verified", "demo"] }
      },
      "required": ["accommodationId", "name", "accommodationType", "address", "city", "latitude", "longitude", "priceSource", "lastVerified", "dataOrigin"]
    }
  },
  "firestore": {
    "/providers/{providerId}": {
      "schema": { "$ref": "#/entities/Provider" },
      "description": "Healthcare provider catalog documents."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Medical service definitions across categories."
    },
    "/providerServices/{recordId}": {
      "schema": { "$ref": "#/entities/ProviderService" },
      "description": "Verified provider-to-service availability records."
    },
    "/medicalCharges/{chargeId}": {
      "schema": { "$ref": "#/entities/MedicalCharge" },
      "description": "Published or illustrative medical service charges."
    },
    "/accommodations/{accommodationId}": {
      "schema": { "$ref": "#/entities/Accommodation" },
      "description": "Nearby accommodation directory documents."
    }
  }
}
